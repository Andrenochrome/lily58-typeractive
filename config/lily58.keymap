#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            label = "Base";
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3    &kp N4        &kp N5                             &kp N6  &kp N7         &kp N8         &kp N9         &kp N0        &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp E     &kp R         &kp T                              &kp Y   &kp U          &kp I          &kp O          &kp P         &kp DE_HASH
&kp LEFT_SHIFT  &kp A   &kp S   &kp D     &kp F         &kp G                              &kp H   &kp J          &kp K          &kp L          &kp DE_PLUS   &kp ENTER
&kp LCTRL       &kp Z   &kp X   &kp C     &kp V         &kp B   &kp DE_CARET    &mo 3      &kp N   &kp M          &kp DE_COMMA   &kp DE_PERIOD  &kp DE_MINUS  &kp RSHFT
                                &kp LALT  &kp LEFT_GUI  &mo 1   &kp SPACE       &kp SPACE  &mo 2   &kp LS(DE_SZ)  &kp RIGHT_ALT
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                         &kp INS  &kp HOME  &trans        &kp END    &trans  &kp KP_NUMLOCK
&trans  &trans  &trans  &trans  &trans  &trans                         &trans   &kp LEFT  &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                         &trans   &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &kp PG_UP
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &kp RA(DEL)  &trans   &trans    &trans        &trans     &trans  &kp PG_DN
                        &trans  &trans  &trans  &trans    &trans       &trans   &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans        &trans  &kp DE_LESS_THAN  &kp RA(DE_LESS_THAN)  &kp LS(DE_LESS_THAN)  &kp LS(DE_SZ)                             &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans            &trans                &trans                &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&kp CAPSLOCK  &trans  &trans            &trans                &kp LG(LS(DE_S))      &kp PRINTSCREEN                           &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans            &trans                &trans                &kp PAUSE_BREAK  &kp LS(DE_N7)    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans                &trans                &trans           &trans           &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            label = "Lower";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12                    &trans      &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans   &trans   &trans                     &trans      &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans      &trans        &trans        &trans        &trans        &trans
                        &trans   &trans   &trans   &trans    &trans  &trans      &trans        &trans
            >;
        };
    };
};
