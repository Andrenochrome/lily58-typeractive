#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            label = "Base";
            bindings = <
&kp ESC         &kp N1    &kp N2    &kp N3    &kp N4        &kp N5                             &kp N6    &kp N7    &kp N8         &kp N9         &kp N0        &kp BACKSPACE
&kp TAB         &kp DE_Q  &kp DE_D  &kp DE_R  &kp DE_W      &kp DE_B                           &kp DE_J  &kp DE_F  &kp DE_U       &kp DE_P       &kp SLASH     &kp BACKSLASH
&kp LEFT_SHIFT  &kp DE_A  &kp DE_S  &kp DE_H  &kp DE_T      &kp DE_G                           &kp DE_Y  &kp DE_N  &kp DE_E       &kp DE_O       &kp DE_I      &kp DE_HASH
&kp LCTRL       &kp DE_Z  &kp DE_X  &kp DE_M  &kp DE_C      &kp DE_V  &kp CARET    &kp DELETE  &kp DE_K  &kp DE_L  &kp DE_COMMA   &kp DE_PERIOD  &kp DE_MINUS  &kp RSHFT
                                    &kp LALT  &kp LEFT_GUI  &mo 1     &kp SPACE    &kp RET     &mo 2     &to 3     &kp RIGHT_ALT
            >;
        };

        layer_1 {
            bindings = <
&kp F1        &kp F2  &kp F3  &kp F4            &kp F5     &kp F6                             &trans  &trans  &trans  &trans  &trans  &trans
&kp F7        &kp F8  &kp F9  &kp F10           &kp F11    &kp F12                            &trans  &trans  &trans  &trans  &trans  &trans
&kp CAPSLOCK  &trans  &trans  &trans            &trans     &trans                             &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &kp LS(LG(DE_S))  &kp PSCRN  &kp PAUSE_BREAK  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                              &trans            &trans     &trans           &trans    &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                         &trans         &kp HOME       &trans            &kp END               &trans                &kp PG_UP
&trans        &trans        &trans        &trans        &trans        &trans                         &trans         &kp LEFT       &kp UP_ARROW      &kp RIGHT             &trans                &kp PG_DN
&trans        &trans        &trans        &trans        &trans        &trans                         &trans         &kp LEFT       &kp DOWN          &kp RIGHT             &trans                &trans
&trans        &trans        &trans        &trans        &trans        &trans  &bt BT_CLR    &kp INS  &kp LS(DE_N7)  &kp RA(DE_SZ)  &kp DE_LESS_THAN  &kp RA(DE_LESS_THAN)  &kp LS(DE_LESS_THAN)  &kp LS(DE_SZ)
                                          &trans        &trans        &trans  &trans        &trans   &trans         &trans         &trans
            >;
        };

        layer_3 {
            label = "Gaming";
            bindings = <
&kp ESCAPE      &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_N4  &kp DE_N5                          &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB         &kp DE_Q   &kp DE_W   &kp DE_E   &kp DE_R   &kp DE_T                           &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp DE_A   &kp DE_S   &kp DE_D   &kp DE_F   &kp DE_G                           &trans  &trans  &trans  &trans  &trans  &trans
&kp DE_CARET    &kp DE_Y   &kp DE_X   &kp DE_C   &kp DE_V   &kp DE_B   &kp DE_M        &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                      &none      &none      &none      &kp DE_SPACE    &trans  &trans  &to 0   &trans
            >;
        };
    };
};
